{
  "name": "pigeon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply pigeon --local",
    "db:migrate:remote": "wrangler d1 migrations apply pigeon --remote",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.4",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "^0.8.3",
    "hono": "^4.10.8",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wrangler": "^4.54.0"
  }
}
